{
  "name": "deploy-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm build:app && pnpm build:worker",
    "build:app": "vite build",
    "build:worker": "esbuild src/worker/index.ts --bundle --outfile=dist/worker.js --format=esm --platform=neutral --external:cloudflare:*",
    "db:migrate": "wrangler d1 execute deploy-dashboard-db --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute deploy-dashboard-db --local --file=schema.sql",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslog": "^4.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
